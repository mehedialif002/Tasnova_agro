# ============================================================
#  Production env for docker-compose. Copy to ".env" on the VPS:
#     cp .env.production.example .env
#  then fill in real values. docker compose reads ".env" automatically.
#  NEVER commit the real .env to GitHub.
# ============================================================

# ---- Database (managed PostgreSQL, e.g. Neon) ----
# Neon dashboard theke connection string niye ekhane boshan.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ---- App secrets ----
# Generate with:  openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_string

# ---- Admin account ----
# NOT stored here. Create it once after the app is running:
#   docker compose exec app node scripts/create-admin.js
# (password is typed interactively and saved only as a bcrypt hash)

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SELLER_EMAIL=youremail@gmail.com

# ---- Public (baked into the site at build time) ----
NEXT_PUBLIC_WHATSAPP_NUMBER=8801912274710
NEXT_PUBLIC_SITE_NAME=Tasnova Agro Farm Ltd.
NEXT_PUBLIC_ORDER_WHATSAPP_TEXT=Hi, ami apnar product niye order dite chai
