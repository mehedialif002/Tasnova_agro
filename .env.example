# ---- Public (browser-e visible) ----
# WhatsApp number MUST be in international format, no +, no spaces
# example: Bangladesh number 01712345678 -> 8801712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=8801912274710
NEXT_PUBLIC_SITE_NAME=Tasnova Agro Farm Ltd.
NEXT_PUBLIC_ORDER_WHATSAPP_TEXT=Hi, ami apnar product niye order dite chai

# ---- Server-only (email pathano) ----
# Gmail use korle: Google Account > Security > 2-Step Verification on korun,
# tarpor "App Passwords" theke 16 digit-er ekta password banan (normal password na)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_16_char_app_password
SELLER_EMAIL=youremail@gmail.com
